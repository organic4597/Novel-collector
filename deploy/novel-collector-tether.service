[Unit]
Description=Novel Collector private tether gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/novel-collector-gateway
EnvironmentFile=/etc/novel-collector-tether.env
ExecStart=/usr/bin/node /opt/novel-collector-gateway/src/tether-broker.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
