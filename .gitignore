# Default deny: only reviewed application source, synthetic tests and public docs.
/*
!/.gitignore
!/LICENSE
!/README.md
!/package.json
!/package-lock.json
!/requirements-captcha.txt
!/run.mjs
!/src/
!/public/
!/tests/
!/tools/
!/docs/
!/deploy/

/src/*
!/src/*.mjs
/public/*
!/public/*.js
!/public/*.html
!/public/*.css
/tests/*
!/tests/*.test.mjs
!/tests/captcha_position_test.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/captcha-reader.html
!/tests/fixtures/work-detail-synthetic.html
!/tests/fixtures/discovery-synthetic.mjs
/tools/*
!/tools/captcha_position.py
!/tools/evaluate_captcha.py
!/tools/check-publication.mjs
/docs/*
!/docs/CAPTCHA.md
!/docs/TESTING.md
!/docs/CONTRACT.md
!/docs/INSTALL.md
!/docs/UPDATE.md
!/docs/TROUBLESHOOTING.md
!/docs/DASHBOARD.md
!/docs/PRESETS.md
!/docs/assets/
/docs/assets/*
!/docs/assets/*.svg
/deploy/*
!/deploy/novel-collector.service

# Defense in depth for future directories.
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/*.tar.gz
**/*.zip
